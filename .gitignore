!backend/ornek_veri/genom/bakteri/
!backend/ornek_veri/genom/bakteri/*.gbff
!backend/ornek_veri/genom/bakteri/*.gbk
# Örnek zaman serisi (kare JPEG'leri + mp4 + zip):
