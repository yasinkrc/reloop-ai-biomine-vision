# BioMine Vision — örnek ortam değişkenleri.
# Bu dosyayı `.env` adıyla kopyalayıp değerleri düzenleyin.

# --- Genel ---
DEBUG=false

# --- Veritabanı ---
# SQLite (ön tanımlı, kurulum gerektirmez):
DATABASE_URL=sqlite:///./veri/biomine.db
# PostgreSQL örneği:
# DATABASE_URL=postgresql+psycopg2://biomine:biomine@localhost:5432/biomine

# --- Dizinler ---
VERI_DIZINI=./veri
MODEL_DIZINI=./modeller

# --- Yapay zeka ---
# otomatik | cpu | cuda
CIHAZ=otomatik
# Omnipose yerleşik modeli: bact_phase_omni | bact_fluor_omni
OMNIPOSE_MODEL=bact_phase_omni
SINIFLANDIRICI_DOSYASI=biomine_siniflandirici.pt
# Hazır ağırlık indirmek için (opsiyonel, yalnızca https):
# SINIFLANDIRICI_URL=
# SINIFLANDIRICI_SHA256=

# --- Yükleme / video ---
MAKS_DOSYA_MB=200
VIDEO_KARE_ARALIGI=2.0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Kural motoru eşikleri (yönetim ekranından da değiştirilebilir) ---
ESIK_guven_dusuk=55
ESIK_guven_uyari=65
ESIK_min_hucre_sayisi=3
ESIK_asiri_yogunluk_kaplama=45
ESIK_asiri_yogunluk_mp=4000
ESIK_baskin_morfoloji_orani=0.60
ESIK_aktivite_kaybi_dusus_orani=0.35
ESIK_bulaniklik_esik=80
ESIK_karanlik_esik=35
ESIK_kritik_uyari_sayisi=2
